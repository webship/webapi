<?php

/**
 * @file
 * Install, update and uninstall functions for the Web API module.
 */

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;

/**
 * Implements hook_install().
 */
function webapi_install($is_syncing) {
  // Configuration imports bring their own configuration, and a recipe installs
  // its modules with the config installer in syncing mode: only a module that
  // is installed on its own applies the default recipe.
  if (!$is_syncing && !\Drupal::isConfigSyncing()) {
    $recipe = Recipe::createFromDirectory(__DIR__ . '/recipes/default');
    RecipeRunner::processRecipe($recipe);
  }

  // A path alias is content, not configuration: neither a configuration import
  // nor a recipe creates it, so it is added in every install mode.
  webapi_add_api_docs_path_alias();
  webapi_generate_oauth_keys();
  webapi_add_api_admin_role();
}

/**
 * Adds the API administrator role shipped in config/optional.
 *
 * A recipe installs its modules in syncing mode, which skips the configuration
 * entities of the module, so the role is created here from the shipped file.
 * A role the site already has is kept, and nothing is created while a module
 * that provides one of its permissions is not installed.
 */
function webapi_add_api_admin_role(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  if ($storage->load('api_admin')) {
    return;
  }

  $file = \Drupal::service('extension.list.module')->getPath('webapi') . '/config/optional/user.role.api_admin.yml';
  $values = Yaml::decode(file_get_contents($file));
  $permissions = \Drupal::service('user.permissions')->getPermissions();
  if (array_diff($values['permissions'], array_keys($permissions))) {
    return;
  }
  $storage->createFromStorageRecord($values)->save();
}

/**
 * Generates the OAuth 2.0 key pair in the private files directory.
 *
 * Simple OAuth cannot sign a token without a private key: /oauth/token answers
 * 500 and the JWKS is empty. The keys go outside the web root, and
 * simple_oauth.settings keeps their private:// paths, which hold on every
 * environment. Keys that are already configured are left alone, and nothing is
 * generated while the site has no private files directory.
 *
 * @return bool
 *   TRUE when a key pair was generated.
 */
function webapi_generate_oauth_keys(): bool {
  if (!\Drupal::moduleHandler()->moduleExists('simple_oauth') || !extension_loaded('openssl')) {
    return FALSE;
  }
  $config = \Drupal::configFactory()->getEditable('simple_oauth.settings');
  if ($config->get('private_key') || $config->get('public_key')) {
    return FALSE;
  }
  if (!\Drupal::service('stream_wrapper_manager')->isValidScheme('private')) {
    return FALSE;
  }

  $file_system = \Drupal::service('file_system');
  $private = $file_system->realpath('private://');
  if (!$private || !is_dir($private) || !is_writable($private)) {
    return FALSE;
  }

  $directory = 'private://simple_oauth';
  if (!$file_system->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS)) {
    return FALSE;
  }
  try {
    \Drupal::service('simple_oauth.key.generator')->generateKeys($file_system->realpath($directory));
  }
  catch (\Exception $exception) {
    \Drupal::logger('webapi')->error('The OAuth 2.0 keys were not generated: @message', ['@message' => $exception->getMessage()]);
    return FALSE;
  }
  $config
    ->set('private_key', $directory . '/private.key')
    ->set('public_key', $directory . '/public.key')
    ->save();
  return TRUE;
}

/**
 * Gives the OpenAPI documentation a readable path.
 */
function webapi_add_api_docs_path_alias() {
  // No check for openapi_ui_swagger: modules of a recipe install in dependency
  // order, so Swagger UI may not be installed yet. The alias answers as soon as
  // it is.
  $path = '/admin/config/services/openapi/swagger/jsonapi';
  $storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $existing = $storage->loadByProperties(['alias' => '/api-docs']);
  if (!empty($existing)) {
    return;
  }

  $storage->create([
    'path' => $path,
    'alias' => '/api-docs',
    'langcode' => LanguageInterface::LANGCODE_NOT_SPECIFIED,
  ])->save();
}

/**
 * Generates the OAuth 2.0 keys that earlier installs never had.
 */
function webapi_update_11001(): void {
  webapi_generate_oauth_keys();
}

/**
 * Adds the /api-docs path alias that recipe installs never created.
 */
function webapi_update_11002(): void {
  webapi_add_api_docs_path_alias();
}

/**
 * Adds the API administrator role that earlier installs never had.
 */
function webapi_update_11003(): void {
  webapi_add_api_admin_role();
}
